{
  "manifest_version": 3,
  "name": "GitMon - Pokémon Contribution Graph",
  "description": "Transforms the GitHub contribution graph into a Charizard evolution-themed graph.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "web_accessible_resources": [{
    "resources": ["assets/*.png"],
    "matches": ["https://github.com/*"]
  }],
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }]
}
